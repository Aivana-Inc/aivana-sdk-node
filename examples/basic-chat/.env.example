# Copy this file to .env and paste an active API key from AI Studio.
# Keep .env local. Never put the key in browser code or share it in chat.
AIVANA_API_KEY=

# Optional. Leave blank for the SDK's production API (https://api.aivana.ai).
# Use the environment that issued your key. For an approved development key:
# AIVANA_API_BASE=https://dev-developers.aivana.ai
AIVANA_API_BASE=

# Optional. The app listens only on 127.0.0.1.
PORT=3006
